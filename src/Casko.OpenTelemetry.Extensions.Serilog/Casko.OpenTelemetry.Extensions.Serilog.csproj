<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Casko.OpenTelemetry.Extensions.Serilog</PackageId>
    <Description>Serilog integration for OpenTelemetry exports.</Description>
    <Authors>Casko</Authors>
    <RepositoryUrl>https://github.com/hallojoe/opentelemetry-extensions</RepositoryUrl>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Serilog.Sinks.OpenTelemetry" />
  </ItemGroup>

</Project>
